---
/**
 * Services.astro
 * Grid of service cards. Data ideally fetched from Sanity via getAllServices().
 * Uses static placeholder data until Sanity is connected.
 */
import { getAllServices } from '../../lib/sanity';
import type { SanityService } from '../../lib/sanity';


// Static fallback data shown until Sanity is configured
const placeholderServices: SanityService[] = [
  {
    _id: '1',
    name: 'Landing Pages',
    slug: { current: 'landing-pages' },
    shortDescription: 'La página que convierte visitantes en clientes. Cada elemento está pensado para que el usuario tome acción, no para que se vea bien en un portafolio.',
    fullDescription: '',
    icon: 'rocket',
    features: ['Diseño orientado a conversión', 'Carga en menos de 1 segundo', 'Conectada a tu herramienta de ventas'],
    order: 1,
    highlighted: false,
  },
  {
    _id: '2',
    name: 'Sitios Web',
    slug: { current: 'sitios-web' },
    shortDescription: 'Presencia profesional que carga rápido, aparece en Google y podés actualizar vos mismo sin tocar una línea de código.',
    fullDescription: '',
    icon: 'globe',
    features: ['Velocidad que Google premia', 'Panel de edición propio y sencillo', 'Adaptado a todos los dispositivos'],
    order: 2,
    highlighted: true,
  },
  {
    _id: '3',
    name: 'Automatizaciones',
    slug: { current: 'automatizaciones' },
    shortDescription: 'Las tareas repetitivas que hacés a mano cada día dejan de existir. Notificaciones, reportes y seguimientos que pasan solos.',
    fullDescription: '',
    icon: 'bolt',
    features: ['Flujos que se activan solos', 'Conecta las herramientas que ya usás', 'Alertas y notificaciones automáticas'],
    order: 3,
    highlighted: false,
  },
  {
    _id: '4',
    name: 'IA & Chatbots',
    slug: { current: 'ia-chatbots' },
    shortDescription: 'Un asistente que conoce tu negocio, atiende clientes a cualquier hora y captura leads mientras vos te dedicás a lo importante.',
    fullDescription: '',
    icon: 'sparkles',
    features: ['Web, WhatsApp y Telegram', 'Entrenado con tu información real', 'Disponible 24/7 sin costo operativo'],
    order: 4,
    highlighted: false,
  },
  {
    _id: '5',
    name: 'CMS & Dashboards',
    slug: { current: 'cms-dashboards' },
    shortDescription: 'El panel que tu equipo realmente necesita: los datos importantes a la vista y el contenido actualizable sin pedirle ayuda a nadie.',
    fullDescription: '',
    icon: 'chart',
    features: ['Interfaz diseñada para tu equipo', 'Reportes y métricas en tiempo real', 'Roles y permisos por usuario'],
    order: 5,
    highlighted: false,
  },
  {
    _id: '6',
    name: 'Integraciones',
    slug: { current: 'integraciones' },
    shortDescription: 'Si tus herramientas no se hablan entre sí, lo resolvemos. Conectamos lo que ya pagás para que trabaje junto y sin fricciones.',
    fullDescription: '',
    icon: 'puzzle',
    features: ['HubSpot, Shopify, Notion, Airtable', 'Sin duplicar trabajo ni perder datos', 'Monitoreo y alertas incluidas'],
    order: 6,
    highlighted: false,
  },
];

// Attempt to load from Sanity; fall back to placeholders
let services: SanityService[] = placeholderServices;
try {
  const fetched = await getAllServices();
  if (fetched.length > 0) services = fetched;
} catch {
  // Sanity not yet configured — using placeholder data
}
---

<section id="servicios" class="py-24 md:py-32" aria-labelledby="services-heading">
  <div class="container-lixan">

    <!-- ── Section header ── -->
    <div class="svc-head" data-animate>
      <div class="section-head">
        <span class="eyebrow mb-5">Lo que hacemos</span>
        <h2 id="services-heading" data-split class="mt-5">
          Servicios para <span class="gradient-text">problemas concretos</span>
        </h2>
      </div>
      <p class="svc-intro">
        Sin paquetes genéricos. Cada entrega resuelve algo específico de tu operación o tu presencia digital.
      </p>
    </div>

    <!-- ── Lista de servicios ── -->
    <ol class="svc-list" role="list">
      {services.map((service, i) => (
        <li class="svc-row" data-animate style={`--ad: ${i * 60}ms`}>
          <span class="svc-num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="svc-name">{service.name}</h3>
          <p class="svc-desc">{service.shortDescription}</p>
          {service.features && service.features.length > 0 && (
            <ul class="svc-feats">
              {service.features.slice(0, 3).map((feature) => <li>{feature}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .svc-head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: end;
    gap: 2rem 4rem;
    margin-bottom: 4rem;
  }

  .svc-intro {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 26rem;
  }

  @media (max-width: 899px) {
    .svc-head { grid-template-columns: 1fr; margin-bottom: 2.5rem; }
  }

  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }

  .svc-row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1.1fr) minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.5rem 2rem;
    align-items: baseline;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  /* Línea que se dibuja al pasar el mouse */
  .svc-row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: #A87DD1;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .svc-row:hover::after { transform: scaleX(1); }

  .svc-num {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .svc-name {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1), color 300ms ease;
  }
  .svc-row:hover .svc-name { transform: translateX(6px); color: #C9B3EC; }

  .svc-desc {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .svc-feats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .svc-feats li::before { content: '— '; opacity: 0.6; }

  @media (max-width: 1023px) {
    .svc-row { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .svc-desc, .svc-feats { grid-column: 2; }
    .svc-row { gap: 0.75rem 1rem; padding: 1.75rem 0; }
  }
</style>
