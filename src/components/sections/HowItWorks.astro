---
/**
 * HowItWorks.astro
 * Step-by-step process section. Shows clients how working with Lixan looks.
 * Reduces friction and objections before the CTA.
 * Steps are editable from Sanity Studio → "Página Principal".
 */
import { getHomePage } from '../../lib/sanity';
import type { SanityProcessStep } from '../../lib/sanity';

// Inline SVG per step — Heroicons outline 1.5px stroke, 24×24
// Each icon is a distinct futuristic symbol that matches the step meaning.
const stepIcons: Record<string, string> = {
  // Lupa / MagnifyingGlass — Diagnóstico: entender el negocio
  target: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M15.5 15.5L21 21" />
    <circle cx="10.5" cy="10.5" r="7.5" />
    <path d="M10.5 7.5v3l2 2" />
  </svg>`,

  // Clipboard con lista + check — Propuesta: documento con alcance
  proposal: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" />
    <rect x="9" y="3" width="6" height="4" rx="1" />
    <path d="M9 12h6M9 16h4" />
    <path d="M14 16l1.5 1.5L18 14" />
  </svg>`,

  // Terminal / código — Construcción: desarrollo con actualizaciones
  build: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <path d="M3 8h18" />
    <path d="M7 6.5h.01M9.5 6.5h.01M12 6.5h.01" />
    <path d="M8 13l2.5 2L8 17M13 17h3" />
  </svg>`,

  // Cohete — Entrega: lanzamiento y soporte post-entrega
  launch: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2l2.3-2.3a5.95 5.95 0 003.6.9c3.64-.16 6.77-3.29 6.6-7a8 8 0 00-8-7 5.95 5.95 0 00-.9 3.6L4.5 16.5z" />
    <circle cx="15" cy="9" r="1.5" />
    <path d="M9.5 14.5L5 19" />
  </svg>`,
};

const fallbackSteps: SanityProcessStep[] = [
  {
    _key: '1',
    number: '01',
    title: 'Diagnóstico',
    description:
      'Una llamada de 30 minutos para entender tu negocio, tus herramientas y el problema que queremos resolver. Sin demos de ventas ni cuestionarios interminables.',
    icon: 'target',
  },
  {
    _key: '2',
    number: '02',
    title: 'Propuesta',
    description:
      'En 48 horas recibes una propuesta con alcance, entregables y precio fijo. Sabes exactamente qué vas a recibir antes de comprometerte con nada.',
    icon: 'proposal',
  },
  {
    _key: '3',
    number: '03',
    title: 'Construcción',
    description:
      'Desarrollamos con actualizaciones semanales reales. Tienes visibilidad del avance, no un informe cada dos semanas que dice "en progreso".',
    icon: 'build',
  },
  {
    _key: '4',
    number: '04',
    title: 'Entrega y soporte',
    description:
      'Documentamos todo y hacemos el traspaso contigo. Incluye 30 días de garantía para ajustes y correcciones post-lanzamiento.',
    icon: 'launch',
  },
];

let steps: SanityProcessStep[] = fallbackSteps;
try {
  const page = await getHomePage();
  if (page?.processSteps && page.processSteps.length > 0) {
    steps = page.processSteps;
  }
} catch {
  // Sanity unavailable — using static fallback
}
---

<section id="proceso" class="py-24 md:py-32 relative overflow-hidden" aria-labelledby="how-heading">
  <!-- Background decoration -->
  <div aria-hidden="true" class="pointer-events-none absolute left-0 top-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-electric-500/10 blur-[100px]"></div>

  <div class="container-lixan relative z-10">

    <!-- ── Section header ── -->
    <div class="text-center mb-16" data-animate>
      <span class="eyebrow mb-5"><span class="eyebrow-dot"></span>
        Cómo trabajamos
      </span>
      <h2 id="how-heading" data-split class="text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4">
        De la llamada al lanzamiento, <span class="gradient-text">sin sorpresas</span>
      </h2>
      <p class="text-text-secondary max-w-xl mx-auto text-lg">
        Cuatro pasos. Sabes qué esperar en cada uno.
      </p>
    </div>

    <!-- ── Steps ── -->
    <div class="relative" id="how-steps">
      <!-- Vertical line connector (desktop) -->
      <div
        aria-hidden="true"
        class="hidden md:block absolute left-1/2 top-8 bottom-8 w-px bg-gradient-to-b from-brand-500/0 via-brand-500/30 to-brand-500/0 -translate-x-1/2"
      ></div>
      <!-- Línea que se llena con el scroll -->
      <div aria-hidden="true" class="how-fill hidden md:block"><span id="how-fill-bar"></span></div>

      <div class="space-y-8 md:space-y-0">
        {steps.map((step, i) => (
          <div
            class={`md:grid md:grid-cols-2 md:gap-12 items-center ${
              i % 2 === 0 ? '' : 'md:[&>*:first-child]:order-last'
            }`}
          >
            <!-- Content card -->
            <div
              data-animate={i % 2 === 0 ? 'left' : 'right'}
              style={`--ad: ${i * 100}ms`}
              class={`group p-6 md:p-8 rounded-brand border border-surface-700 bg-surface-900 hover:border-brand-500/40 hover:shadow-[0_0_32px_rgba(109,61,247,0.22)] transition-all duration-300 hover:-translate-y-1 ${
                i % 2 === 0 ? 'md:text-right' : 'md:text-left'
              }`}
            >
              <!-- Icon + step number row (icon always visible; number badge on mobile) -->
              <div class="flex items-center gap-3 mb-5 md:block">
                <div
                  class="w-12 h-12 rounded-xl bg-brand-500/10 flex items-center justify-center shrink-0 group-hover:bg-brand-500/20 transition-colors md:mb-5"
                  set:html={Object.values(stepIcons)[i] ?? stepIcons['target']}
                />
                <span class="md:hidden text-xs font-extrabold text-brand-400 tracking-widest">{step.number}</span>
              </div>
              <h3 class="text-xl font-bold text-text-primary mb-3">{step.title}</h3>
              <p class="text-text-secondary text-sm leading-relaxed">{step.description}</p>
            </div>

            <!-- Step number (center) -->
            <div class="hidden md:flex justify-center items-center">
              <div class="how-dot w-14 h-14 rounded-full bg-surface-800 border-2 border-brand-500/60 flex items-center justify-center text-brand-400 font-extrabold text-sm shadow-lg shadow-brand-500/20">
                {step.number}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ── Bottom CTA ── -->
    <div class="text-center mt-16">
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-pill bg-brand-500 hover:bg-brand-400 text-white font-semibold text-base transition-all duration-200 shadow-lg shadow-brand-500/30 hover:-translate-y-0.5"
      >
        Cuéntanos tu proyecto
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .how-fill {
    position: absolute;
    left: 50%;
    top: 2rem;
    bottom: 2rem;
    width: 2px;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .how-fill span {
    display: block;
    height: 100%;
    transform: scaleY(var(--fill, 0));
    transform-origin: 50% 0;
    background: linear-gradient(to bottom, #A87DD1, #855dff 60%, #9AAD1A);
    box-shadow: 0 0 14px rgba(133, 93, 255, 0.6);
    border-radius: 2px;
  }
  .how-dot {
    position: relative;
    z-index: 1;
    transition: background-color 500ms ease, color 500ms ease, transform 600ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 500ms ease, border-color 500ms ease;
  }
  .how-dot.is-lit {
    background: linear-gradient(135deg, #7B4CB3, #5A3285);
    border-color: #A87DD1;
    color: #fff;
    transform: scale(1.12);
    box-shadow: 0 0 0 6px rgba(123, 76, 179, 0.15), 0 0 30px rgba(133, 93, 255, 0.55);
  }
</style>

<script>
  const wrap = document.getElementById('how-steps');
  const fill = document.getElementById('how-fill-bar');
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.how-dot'));
  let queued = false;

  function paint() {
    queued = false;
    if (!wrap || !fill) return;
    const r = wrap.getBoundingClientRect();
    const anchor = window.innerHeight * 0.6;
    const p = Math.min(1, Math.max(0, (anchor - r.top) / r.height));
    fill.style.setProperty('--fill', p.toFixed(4));
    dots.forEach((d) => {
      const dr = d.getBoundingClientRect();
      d.classList.toggle('is-lit', dr.top + dr.height / 2 < anchor);
    });
  }

  window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(paint); } }, { passive: true });
  window.addEventListener('resize', paint);
  paint();
</script>
