---
/**
 * HowItWorks.astro
 * Step-by-step process section. Shows clients how working with Lixan looks.
 * Reduces friction and objections before the CTA.
 * Steps are editable from Sanity Studio → "Página Principal".
 */
import { getHomePage } from '../../lib/sanity';
import type { SanityProcessStep } from '../../lib/sanity';


const fallbackSteps: SanityProcessStep[] = [
  {
    _key: '1',
    number: '01',
    title: 'Diagnóstico',
    description:
      'Una llamada de 30 minutos para entender tu negocio, tus herramientas y el problema que queremos resolver. Sin demos de ventas ni cuestionarios interminables.',
    icon: 'target',
  },
  {
    _key: '2',
    number: '02',
    title: 'Propuesta',
    description:
      'En 48 horas recibes una propuesta con alcance, entregables y precio fijo. Sabes exactamente qué vas a recibir antes de comprometerte con nada.',
    icon: 'proposal',
  },
  {
    _key: '3',
    number: '03',
    title: 'Construcción',
    description:
      'Desarrollamos con actualizaciones semanales reales. Tienes visibilidad del avance, no un informe cada dos semanas que dice "en progreso".',
    icon: 'build',
  },
  {
    _key: '4',
    number: '04',
    title: 'Entrega y soporte',
    description:
      'Documentamos todo y hacemos el traspaso contigo. Incluye 30 días de garantía para ajustes y correcciones post-lanzamiento.',
    icon: 'launch',
  },
];

let steps: SanityProcessStep[] = fallbackSteps;
try {
  const page = await getHomePage();
  if (page?.processSteps && page.processSteps.length > 0) {
    steps = page.processSteps;
  }
} catch {
  // Sanity unavailable — using static fallback
}
---

<section id="proceso" class="py-24 md:py-32 relative overflow-hidden" aria-labelledby="how-heading">

  <div class="container-lixan relative z-10">

    <!-- ── Section header ── -->
    <div class="section-head mb-14" data-animate>
      <h2 id="how-heading" data-split>
        De la llamada al lanzamiento, <span class="gradient-text">sin sorpresas</span>
      </h2>
      <p class="text-text-secondary max-w-xl text-lg mt-4">
        Cuatro pasos. Sabes qué esperar en cada uno.
      </p>
    </div>

    <!-- ── Steps ── -->
    <div class="relative" id="how-steps">
      <!-- Vertical line connector (desktop) -->
      <div
        aria-hidden="true"
        class="hidden md:block absolute left-1/2 top-8 bottom-8 w-px bg-gradient-to-b from-brand-500/0 via-brand-500/30 to-brand-500/0 -translate-x-1/2"
      ></div>
      <!-- Línea que se llena con el scroll -->
      <div aria-hidden="true" class="how-fill hidden md:block"><span id="how-fill-bar"></span></div>

      <div class="space-y-8 md:space-y-0">
        {steps.map((step, i) => (
          <div
            class={`md:grid md:grid-cols-2 md:gap-12 items-center ${
              i % 2 === 0 ? '' : 'md:[&>*:first-child]:order-last'
            }`}
          >
            <!-- Content card -->
            <div
              data-animate={i % 2 === 0 ? 'left' : 'right'}
              style={`--ad: ${i * 100}ms`}
              class={`group p-6 md:p-8 rounded-xl border border-white/8 bg-surface-900/60 hover:border-white/20 transition-all duration-300 ${
                i % 2 === 0 ? 'md:text-right' : 'md:text-left'
              }`}
            >
              <span class="md:hidden block text-xs font-semibold text-text-muted tracking-widest mb-3">{step.number}</span>
              <h3 class="text-2xl font-semibold text-text-primary mb-3">{step.title}</h3>
              <p class="text-text-secondary text-sm leading-relaxed">{step.description}</p>
            </div>

            <!-- Step number (center) -->
            <div class="hidden md:flex justify-center items-center">
              <div class="how-dot w-14 h-14 rounded-full bg-surface-800 border border-white/15 flex items-center justify-center text-text-secondary font-semibold text-sm">
                {step.number}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ── Bottom CTA ── -->
    <div class="text-center mt-16">
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-text-primary hover:bg-lixan-purple-light text-surface-950 font-semibold text-base transition-all duration-200"
      >
        Cuéntanos tu proyecto
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .how-fill {
    position: absolute;
    left: 50%;
    top: 2rem;
    bottom: 2rem;
    width: 1px;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .how-fill span {
    display: block;
    height: 100%;
    transform: scaleY(var(--fill, 0));
    transform-origin: 50% 0;
    background: #A87DD1;
    border-radius: 2px;
  }
  .how-dot {
    position: relative;
    z-index: 1;
    transition: background-color 500ms ease, color 500ms ease, transform 600ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 500ms ease, border-color 500ms ease;
  }
  .how-dot.is-lit {
    background: #f4f1fb;
    border-color: #f4f1fb;
    color: #0c0b12;
  }
</style>

<script>
  const wrap = document.getElementById('how-steps');
  const fill = document.getElementById('how-fill-bar');
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.how-dot'));
  let queued = false;

  function paint() {
    queued = false;
    if (!wrap || !fill) return;
    const r = wrap.getBoundingClientRect();
    const anchor = window.innerHeight * 0.6;
    const p = Math.min(1, Math.max(0, (anchor - r.top) / r.height));
    fill.style.setProperty('--fill', p.toFixed(4));
    dots.forEach((d) => {
      const dr = d.getBoundingClientRect();
      d.classList.toggle('is-lit', dr.top + dr.height / 2 < anchor);
    });
  }

  window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(paint); } }, { passive: true });
  window.addEventListener('resize', paint);
  paint();
</script>
